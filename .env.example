# IntelliScope AI — Environment Configuration Template
# Copy this file to .env for local or deployment configuration.
# Never commit actual secret keys or .env files to Git.

# ==============================================================================
# Core Backend Server (FastAPI / Uvicorn)
# ==============================================================================
# Host to bind (0.0.0.0 for Render/containers/production; 127.0.0.1 for local isolation)
HOST=0.0.0.0

# Port for IntelliScope backend:
# - Local development: 8010 (strictly preserved; port 8000 is reserved for AID-DRAS)
# - Render deployment: Render sets $PORT dynamically (FastAPI reads PORT from environment)
PORT=8010

# Allowed CORS origins for browser web requests (comma-separated, or * for open development)
# Local development: CORS_ALLOWED_ORIGINS=*
# Render deployment example:
# CORS_ALLOWED_ORIGINS=https://intelliscope-frontend.onrender.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=*

# Pipeline step execution timeout in seconds
PIPELINE_STEP_TIMEOUT_SECONDS=30.0

# Integration adapter timeout & retry guards
INTEGRATION_DEFAULT_TIMEOUT_SECONDS=15.0
INTEGRATION_MAX_RETRIES=1

# Backend URL used by background agents (scripts/band_collector_agent.py) and MCP server:
# - Local development: http://127.0.0.1:8010
# - Remote Render deployment: https://intelliscope-backend.onrender.com
INTELLISCOPE_BACKEND_URL=http://127.0.0.1:8010

# Optional custom path for pipeline history JSON file (defaults to data/processed/pipeline_history.json)
# Note: Render Free Web Service has ephemeral disk; data resets upon container sleep/restart.
# HISTORY_STORAGE_PATH=data/processed/pipeline_history.json

# ==============================================================================
# Frontend Build Configuration (Vite React)
# ==============================================================================
# Base URL compiled into frontend assets at build time (npm run build).
# - Local development default: http://127.0.0.1:8010
# - Render Static Site build env var: https://intelliscope-backend.onrender.com
# IMPORTANT: Must be configured in the Render Static Site dashboard BEFORE building,
# as Vite inlines this value into the production JavaScript bundle.
VITE_API_BASE_URL=http://127.0.0.1:8010

# ==============================================================================
# Sponsor Platform Integrations (Diwali Festiverse)
# ==============================================================================

# --- BAND Platform (band.ai / band-sdk 6.0.1) [MANDATORY TRACK SPONSOR] ---
# Supported via environment variables or agent_config.yaml (git-ignored)
# BAND_AGENT_ID=your-band-agent-uuid-here
# BAND_API_KEY=your-band-agent-api-key-here
# BAND_USER_API_KEY=optional-human-user-api-key-for-automated-room-tests
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_CONFIG_PATH=agent_config.yaml

# --- Lyzr Agent Studio (v3 REST API) [MANDATORY TRACK SPONSOR] ---
# LYZR_API_KEY=your-lyzr-studio-api-key-here
# LYZR_AGENT_ID=your-lyzr-agent-id-here
# LYZR_WORKFLOW_ID=optional-superflow-workflow-id-here
LYZR_ENABLE_PIPELINE_DELEGATION=false
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3
LYZR_USER_ID=intelliscope-orchestrator

# --- AdaL CLI / SDK (SylphAI) [MANDATORY TRACK SPONSOR] ---
# Requires local 'adal' binary or 'adal_agent_sdk' Python package
ADAL_ENABLED=false
# ADAL_CLI_PATH=/usr/local/bin/adal

# --- Finch Desktop (MCP JSON-RPC / Skill) [MANDATORY TRACK SPONSOR] ---
# Integrated locally via scripts/intelliscope_mcp_server.py & integrations/finch/mcp_servers.json
FINCH_ENABLED=false
# FINCH_MCP_URL=http://127.0.0.1:3800/mcp

# --- Agent37 Cloud Sandboxes [OPTIONAL TRACK SPONSOR / CREDITS PRIZE] ---
# AGENT37_API_KEY=sk_live_your-agent37-api-key-here
# AGENT37_INSTANCE_ID=your-agent37-instance-id-here
AGENT37_API_URL=https://api.agent37.com
AGENT37_SANDBOX_URL=https://sandbox.agent37.app
